#compdef claude-provider

# Completion for the claude-provider management command.
# Autoloaded by compinit via fpath.

local -a provider_names
provider_names=("${(@f)$( _claude_providers_load && print -rl -- "${_CLAUDE_PROVIDER_NAMES[@]}" )}")

local -a commands providers
local name
commands=(
  'list:List all available providers'
  'edit:Edit and validate provider configuration'
  'show:Show details of a provider'
  'help:Show help message'
)

for name in "${provider_names[@]}"; do
  providers+=("${name}:Provider")
done

_arguments -C \
  '1: :->command' \
  '2: :->provider' && return 0

case $state in
  command)
    _describe 'command' commands
    ;;
  provider)
    case "${words[2]}" in
      show|info) _describe 'provider' providers ;;
      *) _message 'provider name' ;;
    esac
    ;;
esac